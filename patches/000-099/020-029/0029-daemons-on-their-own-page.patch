+
+/* ---- Daemons ------------------------------------------------------------------------------
+   A row is state, not decoration: the dot is the control that flips the service, and it says up or
+   down with the same green the rest of the app uses for "running". Colours come from the theme
+   variables so a Core build keeps its own palette. */
+.daemon-list { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
+.daemon-row {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  padding: 12px 10px;
+  border-radius: 10px;
+  border: 1px solid transparent;
+}
+.daemon-row:hover { background: var(--raised); border-color: var(--line); }
+.daemon-row > .grow { flex: 1 1 auto; min-width: 0; }
+.daemon-dot {
+  width: 11px; height: 11px; border-radius: 50%; margin-top: 5px; flex: 0 0 auto; padding: 0;
+  cursor: pointer; background: transparent; border: 1px solid var(--muted);
+  transition: transform .12s ease, background-color .12s ease;
+}
+.daemon-dot:hover { transform: scale(1.25); }
+.daemon-dot.on { background: #59c07a; border-color: #59c07a; box-shadow: 0 0 6px #59c07a66; }
+.daemon-meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
+.daemon-meta code {
+  font-family: ui-monospace, monospace; font-size: 11px; color: var(--muted);
+  background: var(--raised); padding: 1px 6px; border-radius: 5px;
+}
+.daemon-actions { display: flex; gap: 6px; flex: none; }
+.daemon-actions .danger { color: var(--danger, #e06c75); }
+.daemon-note { margin-top: 14px; }
+
+/* ---- Expandable nav sections --------------------------------------------------------------- */
+.nav-group { display: flex; flex-direction: column; gap: 1px; }
+.nav-row { display: flex; align-items: center; gap: 0; border-radius: 8px; }
+.nav-row:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
+.nav-disclosure {
+  flex: 0 0 26px; width: 26px; height: 100%; min-height: 26px; display: grid; place-items: center;
+  background: none; border: 0; color: var(--muted); cursor: pointer; padding: 0;
+}
+.nav-disclosure:hover { color: var(--accent); }
+.nav-caret {
+  width: 0; height: 0;
+  border-left: 4.5px solid transparent; border-right: 4.5px solid transparent;
+  border-top: 5px solid currentColor; transition: transform .12s ease;
+}
+.nav-caret.open { transform: rotate(180deg); }
+.nav-group.is-open > .nav-row { background: color-mix(in srgb, var(--accent) 14%, transparent); }
+.nav-group.is-open > .nav-row .nav-caret { color: var(--accent); }
+.nav-children {
+  display: flex; flex-direction: column; gap: 1px; margin: 1px 0 3px 26px;
+  border-left: 1px solid var(--line); padding-left: 6px;
+}
+.nav-child {
+  display: block; width: 100%; text-align: left; background: none; border: 0; color: var(--muted);
+  font: inherit; font-size: 12px; padding: 5px 8px; border-radius: 6px; cursor: pointer;
+}
+.nav-child:hover, .nav-child:focus-visible { color: var(--text); background: var(--raised); outline: none; }
